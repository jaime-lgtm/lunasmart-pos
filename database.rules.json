      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "catalogo": {
      "$sucursal": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "modificadores": {
      "$sucursal": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "agotados": {
      "$sucursal": {
        ".read": "auth != null",
        ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
      }
    },
    "horarioTienda": {
      ".read": true,
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "eventos": {
      ".read": "auth != null",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "eventosInscripciones": {
      "$eventoId": {
        ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
        "$regId": {
          ".write": "auth != null && (auth.token.firebase.sign_in_provider === 'password' || !data.exists())",
          ".validate": "newData.hasChildren(['nombre','telefono'])"
        }
      }
    },
    "eventosCupo": {
      "$eventoId": {
        ".read": "auth != null",
        ".write": "auth != null && (auth.token.firebase.sign_in_provider === 'password' || (!data.exists() && newData.val() === 1) || (data.exists() && (newData.val() === data.val() + 1 || newData.val() === data.val() - 1)))",
        ".validate": "newData.isNumber() && newData.val() >= 0"
      }
    },
    ".read": false,
    ".write": false,
    "analitica": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": false
    },
    "clientesAuditoria": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".indexOn": [
        "tel"
      ]
    },
    "cumpleFelicitados": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    },
    "clientesConfig": {
      ".read": "auth != null && auth.token.firebase.sign_in_provider === 'password'",
      ".write": "auth != null && auth.token.firebase.sign_in_provider === 'password'"
    }
